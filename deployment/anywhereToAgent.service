[Unit]
Description=anywhereToAgent relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/anywhereToAgent --data-dir %h/.local/share/anywhereToAgent --config %h/.local/share/anywhereToAgent/config.json --admin-listen 127.0.0.1:9090
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
